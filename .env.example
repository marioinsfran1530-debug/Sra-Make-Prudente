# Copie este arquivo para .env.local e preencha com os valores dos serviços usados pelo catálogo.
# Nunca commite valores reais de chaves, senhas ou tokens.

# -----------------------------
# Supabase / PostgreSQL / Prisma
# -----------------------------
# Conexão com pool para a aplicação (Vercel/serverless).
DATABASE_URL=

# Conexão direta ao Postgres, usada pelo Prisma em migrations e operações administrativas.
# O schema.prisma atual referencia DIRECT_URL explicitamente.
DIRECT_URL=

# Supabase Auth / API pública.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente server-side. Nunca exponha esta chave ao client.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------
# Firebase / notificações push
# -----------------------------
# Configuração pública do app Firebase usada no navegador.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin, somente server-side.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# -----------------------------
# Bluesoft Cosmos / busca por EAN-GTIN
# -----------------------------
# Credenciais somente server-side. Disponíveis na conta Cosmos.
# Se não forem configuradas, a busca tenta a base pública Open Beauty Facts como fallback.
COSMOS_API_TOKEN=
COSMOS_API_USER_AGENT=

# -----------------------------
# Meta Ads / Meta Pixel
# -----------------------------
# ID numérico do Pixel criado no Gerenciador de Eventos da Meta.
# É público por natureza e será usado somente nas páginas da loja, nunca no painel admin.
# Após alterar esta variável na Vercel, faça um novo deploy porque NEXT_PUBLIC_* entra no build do Next.js.
NEXT_PUBLIC_META_PIXEL_ID=

# -----------------------------
# Google Gemini / assistente do Admin
# -----------------------------
# Somente server-side. Crie a chave no Google AI Studio e nunca use prefixo NEXT_PUBLIC_.
GEMINI_API_KEY=

# Modelo em um único ponto de configuração para facilitar futuras trocas/deprecações.
# O padrão do código é gemini-3.5-flash-lite quando esta variável está vazia.
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional. Só altere se o Google migrar o endpoint da Interactions API.
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions

# -----------------------------
# Aplicação
# -----------------------------
# URL pública principal do catálogo.
NEXT_PUBLIC_SITE_URL=https://sramakeprudente.com.br
