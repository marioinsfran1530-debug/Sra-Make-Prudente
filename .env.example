# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.

# Postgres do Supabase (Project Settings > Database > Connection string)
DATABASE_URL=

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nunca exponha esta chave ao client. Só é usada em código server-side
# (Route Handlers /api/admin/*), a partir da Fase 5.
SUPABASE_SERVICE_ROLE_KEY=

# URL final de produção (usada no sitemap, robots.txt e Open Graph — Fase 8)
NEXT_PUBLIC_SITE_URL=https://sramakeprudente.com.br
